{
  "name": "Brian's Brain",
  "version": 1,
  "grid": {
    "width": 20,
    "height": 20,
    "boundary": "wrap"
  },
  "states": [0, 1, 2],
  "neighborhood": {
    "type": "moore",
    "radius": 1
  },
  "rules": [
    {"type": "count", "from": 0, "count": 1, "in": [2], "to": 1, "otherwise": 0},
    {"type": "count", "from": 1, "to": 2},
    {"type": "count", "from": 2, "to": 0}
  ],
  "init": {
    "type": "random",
    "percentages": {"1": 10},
    "seed": 42
  }
}
