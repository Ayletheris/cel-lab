{
  "name": "Forest Fire",
  "version": 1,
  "grid": {"width": 5, "height": 4, "boundary": "wrap"},
  "states": [0, 1, 2],
  "neighborhood": {"type": "moore", "radius": 1},
  "rules": [
    {"type": "count", "from": 2, "to": 0},
    {"type": "count", "from": 1, "count": 2, "in": [1, 2, 3, 4, 5, 6, 7, 8], "to": 2},
    {"type": "count", "from": 0, "to": 0}
  ],
  "init": [
    [0, 1, 1, 1, 0],
    [1, 1, 2, 1, 1],
    [0, 1, 1, 1, 0],
    [0, 0, 1, 0, 0]
  ]
}
